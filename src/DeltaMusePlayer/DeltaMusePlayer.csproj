<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DeltaMusePlayer</RootNamespace>
    <AssemblyName>DeltaMusePlayer</AssemblyName>
    <Version>0.1.0</Version>
    <Company>DeltaMusePlayer</Company>
    <Product>DeltaMuse Player</Product>
    <Description>把 DeltaMuse 导出的单声部 MIDI 转成《三角洲行动》口琴键位并按时序播放（M1：Preview / Trace）</Description>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- 发布形态：win-x64、自包含、单文件。命令行显式给出 RID 时也走进来，
       所以 `dotnet publish src\DeltaMusePlayer\DeltaMusePlayer.csproj -c Release -r win-x64`
       与 `scripts\publish.ps1` 得到的产物一致。
       注意：不能无条件写 RuntimeIdentifier。一旦写了，`dotnet build` 与 ProjectReference
       也会走 RID 专属路径，测试工程会去找 win-x64 版的 NuGet 参考包而报错。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <PropertyGroup>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- 裁剪时钉住的程序集：XAML 的 {Binding} 目标属性和 DryWetMidi 的内部反射都只被反射用到。 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="DeltaMusePlayer" />
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Desktop" />
    <TrimmerRootAssembly Include="Avalonia.Markup" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <TrimmerRootAssembly Include="Avalonia.Skia" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Avalonia.Win32" />
    <TrimmerRootAssembly Include="Melanchall.DryWetMidi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="7.2.0" />
  </ItemGroup>

  <!-- 键位方案随程序分发（运行时也从 exe 同目录读，见 InstrumentProfileLoader 的搜索顺序）。 -->
  <ItemGroup>
    <None Update="profiles\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 合规文本嵌进 exe，随程序分发。 -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\THIRD_PARTY_NOTICES.md" Link="Docs/THIRD_PARTY_NOTICES.md" />
    <AvaloniaResource Include="..\..\LICENSE" Link="Docs/LICENSE" />
  </ItemGroup>

  <!-- 发布目录只留 exe：DryWetMidi 包里带 macOS / Linux 原生库，不是 RID 限定资产。 -->
  <Target Name="RemoveForeignNativeLibsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.dylib' Or '%(Extension)' == '.so'" />
    </ItemGroup>
  </Target>

</Project>
